<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PIXELVERSE // REINICIO CERO (VILLAINS PASS)</title>
    <!-- Carga de Three.js desde CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <style>
        :root {
            --color-bg-base: #020205; 
            --color-neon-cyan: #00f3ff;
            --color-neon-purple: #9d00ff;
            --color-text-primary: #e0e0e0;
            --font-terminal: 'Courier New', Courier, monospace;
            --avatar-skin: #ffccaa;
            --avatar-hair: #331100;
            --avatar-shirt: #00f3ff;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body, html { width: 100vw; height: 100vh; background-color: var(--color-bg-base); color: var(--color-text-primary); font-family: var(--font-terminal); overflow: hidden; user-select: none; }

        #crt-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: linear-gradient(rgba(18,16,16,0) 50%, rgba(0,0,0,0.3) 50%), linear-gradient(90deg, rgba(255,0,0,0.04), rgba(0,255,0,0.01), rgba(0,0,255,0.04)); background-size: 100% 4px, 3px 100%; z-index: 9999; pointer-events: none; opacity: 0.85; }
        .cyber-grid { position: absolute; bottom: 0; left: -50%; width: 200%; height: 60vh; background-image: linear-gradient(to right, var(--color-neon-purple) 1px, transparent 1px), linear-gradient(to top, var(--color-neon-purple) 1px, transparent 1px); background-size: 40px 40px; transform: perspective(500px) rotateX(75deg); transform-origin: top center; z-index: 2; opacity: 0.2; }

        #game-container { position: relative; width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; z-index: 100; }
        .view-state { position: absolute; width: 100%; height: 100%; display: none; flex-direction: column; justify-content: center; align-items: center; opacity: 0; transition: opacity 0.8s ease; }
        .view-state.active { display: flex; opacity: 1; }

        .title-glitch { font-size: 4rem; font-weight: bold; color: #fff; text-shadow: 0 0 20px var(--color-neon-cyan); letter-spacing: 0.5rem; text-align: center; }
        .btn-ui { background: rgba(0,243,255,0.05); color: var(--color-neon-cyan); border: 1px solid var(--color-neon-cyan); padding: 15px 40px; font-family: var(--font-terminal); font-size: 1.2rem; cursor: pointer; text-transform: uppercase; letter-spacing: 3px; transition: 0.3s; margin-top: 20px; z-index: 101; }
        .btn-ui:hover { background: var(--color-neon-cyan); color: var(--color-bg-base); box-shadow: 0 0 25px var(--color-neon-cyan); }

        #webgl-canvas-container { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 5; }
        #cinematic-hud { position: absolute; bottom: 8%; width: 85%; max-width: 900px; background: rgba(2,2,5,0.92); border: 1px solid var(--color-neon-purple); padding: 25px; box-shadow: inset 0 0 25px rgba(157,0,255,0.4), 0 0 20px rgba(0,0,0,0.9); z-index: 10; display: flex; flex-direction: column; align-items: flex-end; border-radius: 4px; }
        #cinematic-text { width: 100%; font-size: 1.3rem; line-height: 1.8; color: #fff; text-align: left; min-height: 50px; text-shadow: 0 0 6px rgba(255,255,255,0.6); }
        .hud-footer { width: 100%; display: flex; justify-content: space-between; align-items: center; margin-top: 15px; border-top: 1px solid rgba(157,0,255,0.3); padding-top: 15px; }
        .scene-counter { font-size: 0.85rem; color: var(--color-neon-purple); letter-spacing: 1px; }
        .skip-hint { font-size: 0.85rem; color: var(--color-neon-cyan); animation: blink 1.5s infinite; cursor: pointer; letter-spacing: 1px; }
        @keyframes blink { 50% { opacity: 0.3; } }

        /* Editor de Avatar */
        .avatar-layout { display: flex; width: 90%; max-width: 900px; height: 60vh; background: rgba(2,2,5,0.85); border: 1px solid var(--color-neon-cyan); box-shadow: 0 0 30px rgba(0,243,255,0.2); }
        .avatar-preview-panel { flex: 1; border-right: 1px solid var(--color-neon-cyan); display: flex; justify-content: center; align-items: center; }
        .avatar-controls-panel { flex: 1; padding: 40px; display: flex; flex-direction: column; gap: 20px; }
        .swatch-container { display: flex; gap: 10px; }
        .swatch { width: 35px; height: 35px; border: 2px solid transparent; cursor: pointer; }
        .swatch:hover, .swatch.selected { border-color: var(--color-neon-cyan); }
        .pixel-character { display: flex; flex-direction: column; align-items: center; transform: scale(5); image-rendering: pixelated; }
        .px-hair { width: 24px; height: 8px; background-color: var(--avatar-hair); }
        .px-head { width: 20px; height: 18px; background-color: var(--avatar-skin); position: relative; }
        .px-eye { position: absolute; width: 4px; height: 4px; background: #000; top: 6px; }
        .px-eye.left { left: 4px; } .px-eye.right { right: 4px; }
        .px-body { width: 26px; height: 22px; background-color: var(--avatar-shirt); margin-top: 2px; }

        /* Gabinete Pong */
        #arcade-cabinet { background-color: #d8a61b; width: 800px; height: 600px; border-radius: 20px 20px 5px 5px; padding: 40px 50px 80px 50px; box-shadow: inset 0 0 60px rgba(0,0,0,0.8), 0 15px 35px rgba(0,0,0,0.6); display: flex; flex-direction: column; align-items: center; border: 4px solid #b38814; }
        #arcade-screen-bezel { width: 100%; height: 100%; background: #111; border-radius: 40px; border: 20px solid #222; position: relative; overflow: hidden; box-shadow: inset 0 0 40px #000; }
        #pong-canvas { width: 100%; height: 100%; background-color: #000; display: block; }
    </style>
</head>
<body>
    <div class="cyber-grid"></div>
    <div id="crt-overlay"></div>

    <div id="game-container">
        <!-- ESTADO 1: CINEMÁTICA 3D CON VILLANOS REALES -->
        <section id="state-cinematic" class="view-state active">
            <div id="webgl-canvas-container"></div>
            <div id="cinematic-hud">
                <div id="cinematic-text">Iniciando secuencia...</div>
                <div class="hud-footer">
                    <span class="scene-counter" id="scene-counter-text">Escena 1 / 5</span>
                    <span class="skip-hint">[ CLIC / ESPACIO ] AVANZAR SECUENCIA</span>
                </div>
            </div>
        </section>

        <!-- ESTADO 2: PANTALLA DE TÍTULO -->
        <section id="state-title" class="view-state">
            <h1 class="title-glitch">PIXELVERSE</h1>
            <p style="color: var(--color-neon-cyan); letter-spacing: 5px; margin-top: 10px;">EL REINICIO DEL UNIVERSO</p>
            <button class="btn-ui" id="btn-start">Iniciar Partida</button>
        </section>

        <!-- ESTADO 3: EDITOR DE AVATAR -->
        <section id="state-avatar" class="view-state">
            <h2 class="title-glitch" style="font-size: 2.5rem; margin-bottom: 20px;">ARQUITECTO DEL PÍXEL</h2>
            <div class="avatar-layout">
                <div class="avatar-preview-panel">
                    <div class="pixel-character">
                        <div class="px-hair"></div>
                        <div class="px-head"><div class="px-eye left"></div><div class="px-eye right"></div></div>
                        <div class="px-body"></div>
                    </div>
                </div>
                <div class="avatar-controls-panel">
                    <h3 style="color: var(--color-neon-purple);">Tono de Piel</h3>
                    <div class="swatch-container" id="s-skin">
                        <div class="swatch selected" style="background:#ffccaa;" data-color="#ffccaa"></div>
                        <div class="swatch" style="background:#d4a373;" data-color="#d4a373"></div>
                        <div class="swatch" style="background:#8b5a2b;" data-color="#8b5a2b"></div>
                    </div>
                    <h3 style="color: var(--color-neon-purple); margin-top:10px;">Cabello</h3>
                    <div class="swatch-container" id="s-hair">
                        <div class="swatch selected" style="background:#331100;" data-color="#331100"></div>
                        <div class="swatch" style="background:#eebb00;" data-color="#eebb00"></div>
                        <div class="swatch" style="background:#aa0000;" data-color="#aa0000"></div>
                    </div>
                    <h3 style="color: var(--color-neon-purple); margin-top:10px;">Ropa</h3>
                    <div class="swatch-container" id="s-shirt">
                        <div class="swatch selected" style="background:#00f3ff;" data-color="#00f3ff"></div>
                        <div class="swatch" style="background:#ff00ff;" data-color="#ff00ff"></div>
                        <div class="swatch" style="background:#39ff14;" data-color="#39ff14"></div>
                    </div>
                    <button class="btn-ui" id="btn-confirm" style="margin-top:auto;">Confirmar Identidad</button>
                </div>
            </div>
        </section>

        <!-- ESTADO 4: PONG -->
        <section id="state-pong" class="view-state">
            <div id="arcade-cabinet">
                <h2 style="color:#111; font-size:2.5rem; margin-bottom:5px; font-family: Arial;">PONG</h2>
                <div id="arcade-screen-bezel">
                    <canvas id="pong-canvas" width="600" height="400"></canvas>
                </div>
                <p style="color:#333; margin-top:10px; font-weight:bold; font-family:sans-serif;">W / S - MOVER PALETA | GANA A LOS 3 PUNTOS</p>
            </div>
        </section>
    </div>

    <script>
        class Cinematic3DPlayer {
            constructor(onComplete) {
                this.onComplete = onComplete;
                this.container = document.getElementById('webgl-canvas-container');
                this.textEl = document.getElementById('cinematic-text');
                this.counterEl = document.getElementById('scene-counter-text');
                
                this.script = [
                    "El universo de los videojuegos funcionaba con normalidad en la ciudad arcade.",
                    "De repente, una anomalía apaga las máquinas. Los mundos se fracturan.",
                    "Los grandes villanos celebran su victoria en un altar oscuro, pero la anomalía también los absorbe.",
                    "Todo se apaga. Oscuridad absoluta.",
                    "Aparece un único píxel. Nace Pixel."
                ];
                this.currentIndex = 0;
                
                this.initThree();
                this.initEvents();
                this.showScriptLine();
            }

            initThree() {
                this.scene = new THREE.Scene();
                this.scene.fog = new THREE.FogExp2(0x020205, 0.025);

                this.camera = new THREE.PerspectiveCamera(65, window.innerWidth / window.innerHeight, 0.1, 1000);
                this.camera.position.set(0, 3, 10);

                this.renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false, powerPreference: "high-performance" });
                this.renderer.setSize(window.innerWidth, window.innerHeight);
                this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
                this.renderer.toneMapping = THREE.ACESFilmicToneMapping;
                this.renderer.toneMappingExposure = 1.3;
                this.container.appendChild(this.renderer.domElement);

                // --- ILUMINACIÓN ---
                const ambientLight = new THREE.AmbientLight(0x0a0a1a, 2.0);
                this.scene.add(ambientLight);
                const cyanNeon = new THREE.PointLight(0x00f3ff, 2, 20);
                cyanNeon.position.set(-6, 4, 0);
                this.scene.add(cyanNeon);
                const purpleNeon = new THREE.PointLight(0x9d00ff, 2, 20);
                purpleNeon.position.set(6, 4, 0);
                this.scene.add(purpleNeon);

                // --- SUELO NEÓN ---
                const floorGeo = new THREE.PlaneGeometry(60, 60);
                const floorMat = new THREE.MeshStandardMaterial({ color: 0x05050f, roughness: 0.15, metalness: 0.9 });
                this.floor = new THREE.Mesh(floorGeo, floorMat);
                this.floor.rotation.x = -Math.PI / 2;
                this.floor.position.y = -1.8;
                this.scene.add(this.floor);

                const gridHelper = new THREE.GridHelper(60, 40, 0x00f3ff, 0x9d00ff);
                gridHelper.position.y = -1.78;
                this.scene.add(gridHelper);

                // --- NÚCLEO (ANOMALÍA) ---
                const coreGeometry = new THREE.IcosahedronGeometry(1.8, 2);
                const coreMaterial = new THREE.MeshPhysicalMaterial({
                    color: 0x9d00ff, emissive: 0x7700cc, emissiveIntensity: 0.9, roughness: 0.1, metalness: 0.9, transmission: 0.7, thickness: 1.5
                });
                this.coreMesh = new THREE.Mesh(coreGeometry, coreMaterial);
                this.coreMesh.position.set(0, 1.5, -6); // Elevamos un poco la anomalía
                this.scene.add(this.coreMesh);

                // --- CREACIÓN DE VILLANOS (VOXEL ART PROCEDURAL) ---
                this.villainsGroup = new THREE.Group();
                this.villainsGroup.position.set(0, 1.5, -6); // Centrados en la anomalía
                this.createVillains();
                this.scene.add(this.villainsGroup);

                // --- PARTÍCULAS ESTELARES ---
                const particlesCount = 300;
                const particleGeometry = new THREE.BufferGeometry();
                const particlePositions = new Float32Array(particlesCount * 3);
                for(let i = 0; i < particlesCount * 3; i += 3) {
                    particlePositions[i] = (Math.random() - 0.5) * 25;
                    particlePositions[i+1] = Math.random() * 8 - 1;
                    particlePositions[i+2] = (Math.random() - 0.5) * 30;
                }
                particleGeometry.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
                const particleMaterial = new THREE.PointsMaterial({ color: 0x00f3ff, size: 0.1, transparent: true, opacity: 0.8 });
                this.particleSystem = new THREE.Points(particleGeometry, particleMaterial);
                this.scene.add(this.particleSystem);

                // Loop
                this.clock = new THREE.Clock();
                this.animate = this.animate.bind(this);
                requestAnimationFrame(this.animate);
            }

            createVillains() {
                const radius = 3.5; // Distancia desde el núcleo
                
                // 1. BOWSER (Rey Koopa) - Caparazón verde, piel amarilla, pelo rojo
                const bowser = new THREE.Group();
                const bBodyMat = new THREE.MeshStandardMaterial({color: 0xffcc00, roughness: 0.6});
                const bShellMat = new THREE.MeshStandardMaterial({color: 0x00aa00, roughness: 0.8});
                const bHairMat = new THREE.MeshStandardMaterial({color: 0xff0000, emissive: 0x550000});
                
                const bBody = new THREE.Mesh(new THREE.BoxGeometry(1.2, 1.4, 1), bBodyMat);
                const bShell = new THREE.Mesh(new THREE.BoxGeometry(1.4, 1.2, 0.6), bShellMat);
                bShell.position.set(0, 0, -0.6); // Caparazón en la espalda
                const bHair = new THREE.Mesh(new THREE.BoxGeometry(0.4, 0.4, 0.4), bHairMat);
                bHair.position.set(0, 0.9, 0.2); // Pelo arriba
                bowser.add(bBody, bShell, bHair);
                
                bowser.position.set(Math.cos(0) * radius, -0.5, Math.sin(0) * radius);
                bowser.lookAt(0, 0, 0); // Mirando al centro
                this.villainsGroup.add(bowser);

                // 2. DONKEY KONG (El Mono) - Cuerpo marrón enorme, corbata roja
                const dk = new THREE.Group();
                const dkBodyMat = new THREE.MeshStandardMaterial({color: 0x4a2e15, roughness: 0.9});
                const dkSkinMat = new THREE.MeshStandardMaterial({color: 0xd2a679, roughness: 0.7});
                const dkTieMat = new THREE.MeshStandardMaterial({color: 0xdd0000});

                const dkBody = new THREE.Mesh(new THREE.BoxGeometry(1.6, 1.5, 1.2), dkBodyMat);
                const dkFace = new THREE.Mesh(new THREE.BoxGeometry(0.8, 0.6, 0.4), dkSkinMat);
                dkFace.position.set(0, 0.4, 0.7);
                const dkTie = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.8, 0.1), dkTieMat);
                dkTie.position.set(0, -0.2, 0.65);
                dk.add(dkBody, dkFace, dkTie);

                dk.position.set(Math.cos(Math.PI / 2) * radius, -0.5, Math.sin(Math.PI / 2) * radius);
                dk.lookAt(0, 0, 0);
                this.villainsGroup.add(dk);

                // 3. FANTASMA PAC-MAN (Blinky) - Rojo con ojos blancos
                const ghost = new THREE.Group();
                const ghostMat = new THREE.MeshStandardMaterial({color: 0xff0000, emissive: 0x440000});
                const eyeMat = new THREE.MeshStandardMaterial({color: 0xffffff, emissive: 0xffffff});
                const pupilMat = new THREE.MeshStandardMaterial({color: 0x0000ff});

                const gBody = new THREE.Mesh(new THREE.BoxGeometry(1.2, 1.4, 1.2), ghostMat);
                const gEyeL = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.3, 0.1), eyeMat);
                gEyeL.position.set(-0.3, 0.3, 0.65);
                const gPupilL = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.1, 0.15), pupilMat);
                gPupilL.position.set(-0.25, 0.3, 0.65);
                
                const gEyeR = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.3, 0.1), eyeMat);
                gEyeR.position.set(0.3, 0.3, 0.65);
                const gPupilR = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.1, 0.15), pupilMat);
                gPupilR.position.set(0.35, 0.3, 0.65);

                ghost.add(gBody, gEyeL, gPupilL, gEyeR, gPupilR);
                ghost.position.set(Math.cos(Math.PI) * radius, -0.5, Math.sin(Math.PI) * radius);
                ghost.lookAt(0, 0, 0);
                this.villainsGroup.add(ghost);

                // 4. DR. EGGMAN (Sonic) - Cuerpo rojo circular, mostacho naranja, lentes azules
                const eggman = new THREE.Group();
                const eggBodyMat = new THREE.MeshStandardMaterial({color: 0xcc0000, roughness: 0.5});
                const mustacheMat = new THREE.MeshStandardMaterial({color: 0xff8800});
                const glassMat = new THREE.MeshStandardMaterial({color: 0x0044ff, emissive: 0x001155});

                const eBody = new THREE.Mesh(new THREE.BoxGeometry(1.4, 1.6, 1.2), eggBodyMat);
                const eMustache = new THREE.Mesh(new THREE.BoxGeometry(1.6, 0.3, 0.2), mustacheMat);
                eMustache.position.set(0, 0.1, 0.65);
                const eGlass = new THREE.Mesh(new THREE.BoxGeometry(1.0, 0.3, 0.2), glassMat);
                eGlass.position.set(0, 0.5, 0.65);

                eggman.add(eBody, eMustache, eGlass);
                eggman.position.set(Math.cos(3 * Math.PI / 2) * radius, -0.5, Math.sin(3 * Math.PI / 2) * radius);
                eggman.lookAt(0, 0, 0);
                this.villainsGroup.add(eggman);
            }

            animate() {
                this.animationId = requestAnimationFrame(this.animate);
                const elapsedTime = this.clock.getElapsedTime();

                // Rotación del núcleo de la anomalía
                this.coreMesh.rotation.x = elapsedTime * 0.25;
                this.coreMesh.rotation.y = elapsedTime * 0.35;

                // Animación de los villanos (Órbita de pánico o ser absorbidos según la escena)
                if (this.currentIndex >= 2) {
                    // "la anomalía también los absorbe" -> empiezan a girar y encogerse hacia el centro
                    this.villainsGroup.rotation.y += 0.05; 
                    if (this.villainsGroup.scale.x > 0.05) {
                        this.villainsGroup.scale.x -= 0.005;
                        this.villainsGroup.scale.y -= 0.005;
                        this.villainsGroup.scale.z -= 0.005;
                    }
                } else {
                    // Animación normal flotando alrededor del altar
                    this.villainsGroup.position.y = 1.5 + Math.sin(elapsedTime * 2) * 0.1;
                }

                // Movimiento de cámara
                this.camera.position.x = Math.sin(elapsedTime * 0.15) * 3;
                this.camera.position.z = 10 + Math.cos(elapsedTime * 0.2) * 2;
                this.camera.lookAt(0, 1.5, -6);

                this.renderer.render(this.scene, this.camera);
            }

            initEvents() {
                this.nextHandler = () => this.advance();
                window.addEventListener('click', this.nextHandler);
                window.addEventListener('keydown', (e) => {
                    if (e.code === 'Space') this.advance();
                });
            }

            showScriptLine() {
                if (this.currentIndex >= this.script.length) {
                    this.finish();
                    return;
                }
                this.textEl.innerText = this.script[this.currentIndex];
                this.counterEl.innerText = `Escena ${this.currentIndex + 1} / 5`;
            }

            advance() {
                this.currentIndex++;
                this.showScriptLine();
            }

            finish() {
                window.removeEventListener('click', this.nextHandler);
                cancelAnimationFrame(this.animationId);
                this.renderer.dispose();
                this.onComplete();
            }
        }

        class PongGame {
            constructor(onWin) {
                this.canvas = document.getElementById('pong-canvas');
                this.ctx = this.canvas.getContext('2d');
                this.onWin = onWin;
                this.keys = {};
                window.addEventListener('keydown', e => this.keys[e.key.toLowerCase()] = true);
                window.addEventListener('keyup', e => this.keys[e.key.toLowerCase()] = false);
            }
            start() {
                this.p1 = { y: 150, score: 0 }; 
                this.p2 = { y: 150, score: 0 };
                this.ball = { x: 300, y: 200, dx: 4, dy: 4 };
                this.running = true;
                this.loop();
            }
            loop() {
                if(!this.running) return;
                
                if (this.keys['w'] && this.p1.y > 0) this.p1.y -= 5;
                if (this.keys['s'] && this.p1.y < 320) this.p1.y += 5;
                if (this.ball.y < this.p2.y + 40) this.p2.y -= 3.5;
                if (this.ball.y > this.p2.y + 40) this.p2.y += 3.5;

                this.ball.x += this.ball.dx; 
                this.ball.y += this.ball.dy;

                if (this.ball.y <= 0 || this.ball.y >= 390) this.ball.dy *= -1;
                if (this.ball.x <= 40 && this.ball.y >= this.p1.y && this.ball.y <= this.p1.y + 80) this.ball.dx *= -1.1;
                if (this.ball.x >= 550 && this.ball.y >= this.p2.y && this.ball.y <= this.p2.y + 80) this.ball.dx *= -1.1;

                if (this.ball.x < 0) { this.p2.score++; this.ball.x=300; this.ball.y=200; this.ball.dx=4; }
                if (this.ball.x > 600) { this.p1.score++; this.ball.x=300; this.ball.y=200; this.ball.dx=-4; }

                if (this.p1.score >= 3) { this.running = false; this.onWin(); return; }

                this.ctx.fillStyle = '#000'; this.ctx.fillRect(0,0,600,400);
                this.ctx.fillStyle = '#fff'; this.ctx.shadowBlur = 10; this.ctx.shadowColor = '#fff';
                
                for(let i=0; i<400; i+=20) { this.ctx.fillRect(298, i, 4, 10); }

                this.ctx.fillRect(20, this.p1.y, 10, 80);
                this.ctx.fillRect(570, this.p2.y, 10, 80);
                this.ctx.fillRect(this.ball.x, this.ball.y, 10, 10);
                
                this.ctx.font = '40px monospace';
                this.ctx.fillText(this.p1.score, 180, 50); 
                this.ctx.fillText(this.p2.score, 390, 50);
                this.ctx.shadowBlur = 0;

                requestAnimationFrame(() => this.loop());
            }
        }

        class GameManager {
            constructor() {
                this.cinematicPlayer = new Cinematic3DPlayer(() => {
                    this.transitionState('state-cinematic', 'state-title');
                });

                document.getElementById('btn-start').onclick = () => {
                    this.transitionState('state-title', 'state-avatar');
                };

                ['s-skin', 's-hair', 's-shirt'].forEach(id => {
                    let varName = '--avatar-' + id.split('-')[1];
                    document.querySelectorAll(`#${id} .swatch`).forEach(s => {
                        s.onclick = (e) => {
                            document.querySelectorAll(`#${id} .swatch`).forEach(x => x.classList.remove('selected'));
                            e.target.classList.add('selected');
                            document.documentElement.style.setProperty(varName, e.target.dataset.color);
                        }
                    });
                });

                document.getElementById('btn-confirm').onclick = () => {
                    this.transitionState('state-avatar', 'state-pong');
                    document.querySelector('.cyber-grid').style.opacity = 0;
                    
                    this.pongGame = new PongGame(() => {
                        alert("¡VICTORIA! Pixel se sube a la paleta transformada en vehículo. Siguiente destino: Space Invaders.");
                    });
                    this.pongGame.start();
                };
            }

            transitionState(fromId, toId) {
                document.getElementById(fromId).classList.remove('active');
                document.getElementById(toId).classList.add('active');
            }
        }

        window.onload = () => new GameManager();
    </script>
</body>
</html>